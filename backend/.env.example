# ============================================================
# 2ndGM AI Chess Lab — Backend Environment Variables
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every value marked <CHANGE_ME> with real credentials.
# 3. NEVER commit .env to version control — it is listed in .gitignore.
# ============================================================

# ------------------------------------
# Stockfish Engine
# ------------------------------------
# Absolute path to the Stockfish binary on this machine.
# Windows example:  C:/stockfish/stockfish-windows-x86-64-avx2.exe
# Linux / macOS:    /usr/local/bin/stockfish
STOCKFISH_PATH=<CHANGE_ME>

# Engine search depth (higher = stronger but slower; 20 is a good default)
ANALYSIS_DEPTH=20

# ------------------------------------
# PostgreSQL (Supabase or self-hosted)
# ------------------------------------
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:<CHANGE_ME>@<host>:6543/postgres

# ------------------------------------
# Neo4j (AuraDB or self-hosted)
# ------------------------------------
# Connection URI — use neo4j+s:// for Aura TLS, bolt:// for local
NEO4J_URI=neo4j+s://<CHANGE_ME>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<CHANGE_ME>

# ------------------------------------
# Google Gemini AI
# ------------------------------------
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=<CHANGE_ME>

# ------------------------------------
# CORS — Allowed Origins
# ------------------------------------
# Comma-separated list of origins the backend will accept requests from.
# Development defaults include the Expo web port and local dev servers.
# Add your production domain here before deploying.
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:3000,http://127.0.0.1:19006
