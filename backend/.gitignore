# ============================================================
# Backend .gitignore
# ============================================================

# Secrets — never commit real values
.env
.env.local
.env.*.local

# Python bytecode & caches
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Distribution / build
dist/
build/
*.egg-info/
*.egg

# Test & coverage artefacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Stockfish binary (large binary; install separately per platform)
stockfish*
*.exe
