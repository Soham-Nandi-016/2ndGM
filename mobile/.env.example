# ============================================================
# 2ndGM AI Chess Lab — Mobile (Expo) Environment Variables
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in every value marked <CHANGE_ME>.
# 3. NEVER commit .env to version control — it is listed in .gitignore.
#
# Expo picks up variables prefixed with EXPO_PUBLIC_ automatically
# and embeds them into the client bundle at build time.
# Do NOT put server-side secrets (DB passwords, private API keys)
# in this file — they will be visible in the compiled app bundle.
# ============================================================

# ------------------------------------
# Backend API Base URL
# ------------------------------------
# Point this at your running backend.
# Local dev (iOS simulator / web):  http://localhost:8000
# Local dev (Android emulator):     http://10.0.2.2:8000
# Staging / Production:             https://api.yourdomain.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
